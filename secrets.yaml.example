# Kopie als secrets.yaml im ESPHome-Verzeichnis anlegen und ausfuellen.
# secrets.yaml gehoert NICHT ins Git-Repository.

wifi_ssid: "MeinWLAN"
wifi_password: "MeinWLANPasswort"

# Fallback-Accesspoint, falls das WLAN nicht erreichbar ist
ap_password: "FallbackPasswort"

# ESPHome erzeugt diese beiden beim Anlegen eines neuen Geraets automatisch.
# Eigenen Key erzeugen: https://esphome.io/components/api.html
api_encryption_key: "hier-eigenen-32-byte-base64-key-einsetzen="
ota_password: "eigenes-ota-passwort"
